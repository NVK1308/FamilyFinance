# =====================================================================
# FamilyFinance - Root .gitignore
# Tuyệt đối không đưa dữ liệu tài chính thật, DB, backup, báo cáo thật,
# log cá nhân và các tệp cấu hình chứa secret lên GitHub.
# =====================================================================

# 1. Secrets & Local Configurations
.env
.env.*
!.env.example
.dev.vars
!.dev.vars.example
**/appsettings.local.json
**/appsettings.Production.json
**/wrangler.toml
!**/wrangler.toml.example
**/.worker-url
**/secrets/
**/*credential*
*.pem
*.key

# 2. Local Runtime Directories (Ngoài source/)
/data/
/backup/
/reports/
/logs/
/temp/
/import/
/export/
/config/*.local.json

# 3. Databases & Backups
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
*.dump
*.sql.gz
*.zip
*.7z
*.enc

# 4. Node.js / TypeScript (Backend Worker)
node_modules/
dist/
.wrangler/
coverage/
*.tsbuildinfo
npm-debug.log*

# 5. .NET / C# (Desktop App)
**/bin/
**/obj/
**/out/
**/publish/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.idea/
.vscode/

